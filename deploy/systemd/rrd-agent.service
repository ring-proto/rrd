[Unit]
Description=RRD CNI lifecycle agent
After=network-online.target rke2-server.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rrd-agent --event-socket /run/rrd/agent.sock --control-socket /run/rrd/control.sock
Restart=always
RestartSec=2
RuntimeDirectory=rrd
RuntimeDirectoryMode=0755
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
